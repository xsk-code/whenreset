# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# `.env*` instead of `.env` + `.env*.local`: Next.js also reads
# .env.production / .env.development / .env.test, which the narrower
# patterns left untracked-but-not-ignored — one `git add -A` would have
# committed real credentials. The negation keeps an example file shareable.
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# multiagent cards local symlink
/cards

# workbuddy agent local workspace (memory logs, temp artifacts)
/.workbuddy/
